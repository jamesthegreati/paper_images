{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KCSE Exam Papers Transcription Schema",
  "description": "Complete schema for transcribed KCSE exam papers with questions, sub-questions, marks, and diagrams",
  "type": "object",
  "required": ["year", "generatedAt", "totalSubjects", "totalPapers", "totalQuestions", "subjects"],
  "properties": {
    "year": {
      "type": "integer",
      "description": "The KCSE examination year",
      "minimum": 2010,
      "maximum": 2030
    },
    "generatedAt": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date when the transcription was generated"
    },
    "totalSubjects": {
      "type": "integer",
      "description": "Total number of subjects included in this transcription"
    },
    "totalPapers": {
      "type": "integer",
      "description": "Total number of papers across all subjects"
    },
    "totalQuestions": {
      "type": "integer",
      "description": "Total number of questions across all papers"
    },
    "subjects": {
      "type": "object",
      "description": "Collection of all subjects",
      "properties": {
        "Biology": { "$ref": "#/definitions/subject" },
        "Chemistry": { "$ref": "#/definitions/subject" },
        "Physics": { "$ref": "#/definitions/subject" },
        "Mathematics": { "$ref": "#/definitions/subject" },
        "English": { "$ref": "#/definitions/subject" },
        "Kiswahili": { "$ref": "#/definitions/subject" },
        "Geography": { "$ref": "#/definitions/subject" },
        "Computer-Studies": { "$ref": "#/definitions/subject" }
      }
    }
  },
  "definitions": {
    "subject": {
      "type": "object",
      "required": ["papers"],
      "properties": {
        "papers": {
          "type": "object",
          "description": "Collection of papers for this subject",
          "patternProperties": {
            "^Paper [1-3]$": { "$ref": "#/definitions/paper" }
          }
        }
      }
    },
    "paper": {
      "type": "object",
      "required": ["totalPages", "totalQuestions", "totalMarks", "instructions", "questions"],
      "properties": {
        "totalPages": {
          "type": "integer",
          "description": "Total number of pages in this paper",
          "minimum": 1
        },
        "totalQuestions": {
          "type": "integer",
          "description": "Total number of main questions in this paper",
          "minimum": 0
        },
        "totalMarks": {
          "type": "integer",
          "description": "Total marks available in this paper",
          "minimum": 0
        },
        "instructions": {
          "type": "array",
          "description": "General instructions for the paper",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "description": "Array of all questions in this paper",
          "items": { "$ref": "#/definitions/question" }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["questionNumber", "questionText", "marks", "topic", "pageNumber", "hasSubQuestions", "hasDiagram"],
      "properties": {
        "questionNumber": {
          "type": "integer",
          "description": "The question number",
          "minimum": 1
        },
        "questionText": {
          "type": "string",
          "description": "The full text of the question exactly as written"
        },
        "marks": {
          "type": ["integer", "null"],
          "description": "Total marks for this question (null if distributed across sub-questions)",
          "minimum": 0
        },
        "topic": {
          "type": "string",
          "description": "The curriculum topic this question relates to"
        },
        "pageNumber": {
          "type": "integer",
          "description": "Page number where this question appears (relative to the paper)",
          "minimum": 1
        },
        "hasSubQuestions": {
          "type": "boolean",
          "description": "Whether this question has sub-questions (a, b, c, etc.)"
        },
        "subQuestions": {
          "type": ["array", "null"],
          "description": "Array of sub-questions if hasSubQuestions is true, null otherwise",
          "items": { "$ref": "#/definitions/subQuestion" }
        },
        "hasDiagram": {
          "type": "boolean",
          "description": "Whether this question includes a diagram, table, graph, or figure"
        },
        "diagram": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/diagram" },
            {
              "type": "array",
              "items": { "$ref": "#/definitions/diagram" }
            }
          ],
          "description": "Diagram information (null, single object, or array for multiple diagrams)"
        }
      }
    },
    "subQuestion": {
      "type": "object",
      "required": ["part", "text", "marks", "hasSubParts"],
      "properties": {
        "part": {
          "type": "string",
          "description": "Sub-question letter (a, b, c, etc.)",
          "pattern": "^[a-z]$"
        },
        "text": {
          "type": "string",
          "description": "The text of the sub-question"
        },
        "marks": {
          "type": ["integer", "null"],
          "description": "Marks for this sub-question",
          "minimum": 0
        },
        "hasSubParts": {
          "type": "boolean",
          "description": "Whether this sub-question has further parts (i, ii, iii, etc.)"
        },
        "subParts": {
          "type": ["array", "null"],
          "description": "Array of sub-parts if hasSubParts is true, null otherwise",
          "items": { "$ref": "#/definitions/subPart" }
        }
      }
    },
    "subPart": {
      "type": "object",
      "required": ["part", "text", "marks"],
      "properties": {
        "part": {
          "type": "string",
          "description": "Sub-part identifier (i, ii, iii, etc.)",
          "pattern": "^(i|ii|iii|iv|v|vi|vii|viii|ix|x|xi|xii|xiii|xiv|xv)$"
        },
        "text": {
          "type": "string",
          "description": "The text of the sub-part"
        },
        "marks": {
          "type": ["integer", "null"],
          "description": "Marks for this sub-part",
          "minimum": 0
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["type", "description", "pageNumber", "position", "labels", "sizeEstimate"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of visual element",
          "enum": [
            "labeled_diagram",
            "graph",
            "table",
            "chart",
            "apparatus_setup",
            "map",
            "cross_section",
            "schematic",
            "geometric_figure",
            "equation_or_formula"
          ]
        },
        "description": {
          "type": "string",
          "description": "Detailed description of what the diagram shows, including all labels and features"
        },
        "pageNumber": {
          "type": "integer",
          "description": "Page number where the diagram appears",
          "minimum": 1
        },
        "position": {
          "type": "string",
          "description": "Position on the page",
          "pattern": "^(top|middle|bottom)-(left|center|right)$"
        },
        "labels": {
          "type": "array",
          "description": "Array of all labels visible on the diagram",
          "items": {
            "type": "string"
          }
        },
        "sizeEstimate": {
          "type": "string",
          "description": "Approximate size of the diagram",
          "enum": ["small", "medium", "large", "full-page"]
        }
      }
    }
  }
}
